# Staffwright deployment environment template
# Copy to .env and fill in real values (.env is gitignored — never commit it)

# ---- Gateway access token (required in production; a dev default is used with a warning if unset) ----
DDW_ACCESS_TOKEN=change-me-to-a-long-random-token

# ---- LLM (optional; chat degrades gracefully if unset, everything else works) ----
# DeepSeek cloud:
DDW_DEEPSEEK_API_KEY=
# or local Ollama (http://localhost:11434, no key needed)

# ---- Service ----
DDW_LOG_LEVEL=INFO
DDW_ENV=development        # tighten this in production
DDW_CORS_EXTRA_ORIGINS=    # extra CORS origins, comma-separated
# LAN password-free (OFF by default): token-less access from the local network; keep off for public deployments
DDW_LAN_BYPASS=0
# Trusted reverse-proxy whitelist (IP/CIDR, comma-separated): X-Forwarded-For is trusted only for direct peers on this list
DDW_TRUSTED_PROXIES=

# ---- SearXNG aggregate search (optional sidecar service, default http://127.0.0.1:8888) ----
SEARXNG_URL=http://127.0.0.1:8888

# ---- Organization binding plugin (bindcode-v1, OFF by default; see plugins/ddw_org_relay/README_EN.md) ----
DDW_ORG_RELAY_ENABLED=0
DDW_ORG_RELAY_PRODUCT_TOKENS=      # product tokens, comma-separated (required when enabled)
DDW_ORG_RELAY_SERVER_BASE_URL=     # base URL of this instance's LLM endpoint (set explicitly for public deployments)
